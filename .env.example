EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=kontakt@kolejowy.pttk.pl
CONTACT_TO_EMAIL=kontakt@kolejowy.pttk.pl

# Import z Facebooka (siteapp/management/commands/import_fb_content.py)
FB_PAGE_ID=
