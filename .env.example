# Skopiuj ten plik do .env i uzupełnij wartości.

# Django
SECRET_KEY=change-me-to-a-random-secret-string
DEBUG=1

# Baza danych (opcjonalnie — bez tego używane jest lokalne SQLite)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# E-mail (formularz kontaktowy)
